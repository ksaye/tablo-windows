<Window x:Class="TabloWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:views="clr-namespace:TabloWindows.Views"
        xmlns:vm="clr-namespace:TabloWindows.ViewModels"
        Title="Tablo for Windows" Height="820" Width="1240" MinHeight="560" MinWidth="900"
        Icon="Assets/app.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid>
        <!-- ============ MAIN APP (logged in) ============ -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- left rail -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="18,22,18,10">
                        <TextBlock Text="Tablo for Windows" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DeviceName}" Style="{StaticResource MutedText}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="8,10,8,16">
                        <Button Content="Sign out" Style="{StaticResource GhostButton}"
                                Command="{Binding LogoutCommand}"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <RadioButton Style="{StaticResource NavButton}" Content="📼   Recordings"
                                     IsChecked="{Binding IsRecordings, Mode=OneWay}"
                                     Command="{Binding ShowRecordingsCommand}"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="📡   Live TV"
                                     IsChecked="{Binding IsLiveTv, Mode=OneWay}"
                                     Command="{Binding ShowLiveTvCommand}"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="▦   Multi-view"
                                     IsChecked="{Binding IsMultiView, Mode=OneWay}"
                                     Command="{Binding ShowMultiViewCommand}"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="🗓   Guide"
                                     IsChecked="{Binding IsGuide, Mode=OneWay}"
                                     Command="{Binding ShowGuideCommand}"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="⬇   Exports"
                                     IsChecked="{Binding IsExports, Mode=OneWay}"
                                     Command="{Binding ShowExportsCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- content area -->
            <Grid Grid.Column="1">
                <views:RecordingsView DataContext="{Binding Recordings}"
                    Visibility="{Binding DataContext.IsRecordings,
                        RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                <views:LiveTvView DataContext="{Binding LiveTv}"
                    Visibility="{Binding DataContext.IsLiveTv,
                        RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                <views:MultiViewView DataContext="{Binding MultiView}"
                    Visibility="{Binding DataContext.IsMultiView,
                        RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                <views:GuideView DataContext="{Binding Guide}"
                    Visibility="{Binding DataContext.IsGuide,
                        RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                <views:ExportsView DataContext="{Binding Exports}"
                    Visibility="{Binding DataContext.IsExports,
                        RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>

        <!-- ============ LOGIN GATE ============ -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}"
              Background="{StaticResource Bg}">
            <Border Style="{StaticResource Card}" Width="420" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Padding="34,30">
                <StackPanel>
                    <TextBlock Text="Tablo for Windows" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sign in with your Tablo account" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,6,0,26"/>

                    <TextBlock Text="Email" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Password" Style="{StaticResource MutedText}" Margin="0,14,0,5"/>
                    <PasswordBox x:Name="PasswordBox"/>

                    <CheckBox x:Name="RememberBox" Content="Remember me on this PC" Margin="2,16,0,0"
                              Foreground="{StaticResource Muted}"
                              IsChecked="{Binding RememberMe}"/>

                    <!-- device chooser (shown after a sign-in that lists devices) -->
                    <StackPanel Margin="0,18,0,0"
                                Visibility="{Binding Devices.Count, Converter={StaticResource CountToVis}}">
                        <TextBlock Text="Tablo device" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Connect" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Command="{Binding ConnectSelectedDeviceCommand}"/>
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      DisplayMemberPath="Display"/>
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding LoginError}" Foreground="#FF6B6B" TextWrapping="Wrap"
                               Margin="0,16,0,0" FontSize="12.5"
                               Visibility="{Binding LoginError, Converter={StaticResource NullToVis}}"/>

                    <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource AccentButton}"
                            Margin="0,22,0,0" Click="SignIn_Click"/>

                    <TextBlock Text="Connecting…" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                               Margin="0,14,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ PLAYER OVERLAY ============ -->
        <Grid Background="#FF05080B"
              Visibility="{Binding PlayerOpen, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="20,16" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="{Binding Player.Title}" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Background="#FF3B30" CornerRadius="4" Padding="7,2" Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding Player.IsLive, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="{Binding Player.BehindLive}" Margin="10,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource MutedText}"
                               Visibility="{Binding Player.BehindLive, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="✕  Close" Style="{StaticResource GhostButton}"
                        Command="{Binding ClosePlayerCommand}"/>
            </DockPanel>

            <Border Grid.Row="1" Background="Black">
                <Grid Background="Black">
                    <vlc:VideoView x:Name="VideoView"/>
                    <TextBlock Text="{Binding Player.LoadingText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontSize="16"
                               Visibility="{Binding Player.IsLoading, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Player.ErrorMessage}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#FF9B9B" FontSize="15"
                               TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                               Visibility="{Binding Player.ErrorMessage, Converter={StaticResource NullToVis}}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,16,0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- ±30s skip: recordings, and live channels within what the Tablo has buffered -->
                    <Button Content="⏪  30s" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                            Command="{Binding Player.SkipBackwardCommand}"/>
                    <Button Content="⏯  Play / Pause" Style="{StaticResource GhostButton}"
                            Command="{Binding Player.PlayPauseCommand}"/>
                    <Button Content="30s  ⏩" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Command="{Binding Player.SkipForwardCommand}"/>
                    <Button Content="{Binding MuteText}" Style="{StaticResource GhostButton}" MinWidth="112"
                            Command="{Binding ToggleMuteCommand}" Margin="10,0,0,0"/>
                    <Button Content="⛶  Full Screen" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Click="FullScreen_Click"/>
                    <Button Content="⏹  Stop" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Command="{Binding ClosePlayerCommand}"/>
                </StackPanel>
                <TextBlock Text="Space pause · ← → skip 10s · ↑ ↓ change channel (live) · M mute · F11 or double-click for full screen · Esc to exit"
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ============ MULTI-VIEW OVERLAY ============ -->
        <Grid Background="#FF05080B"
              Visibility="{Binding MultiView.IsOpen, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="20,12" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Multi-view" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="✕  Close" Style="{StaticResource GhostButton}"
                        Command="{Binding MultiView.StopCommand}"/>
            </DockPanel>

            <!-- Pane positions are set in code for 2, 3 or 4 channels (MainWindow.LayoutMultiView). -->
            <Grid x:Name="MvGrid" Grid.Row="1" Margin="12,0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border x:Name="MvPane0" DataContext="{Binding MultiView.Panes[0]}" Margin="4"
                        BorderThickness="3" Background="Black"
                        Visibility="{Binding InUse, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSound}" Value="True">
                                    <Setter Property="BorderBrush" Value="#FFD60A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <!-- The label is the click target for the sound: the video itself is a native
                             window that WPF never sees clicks on. -->
                        <Button DockPanel.Dock="Top" Cursor="Hand" Padding="10,5" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.MultiView.SelectSoundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#FF171C22" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontWeight="Bold" Margin="0,0,8,0"
                                           Foreground="{StaticResource Accent}"/>
                                <TextBlock DockPanel.Dock="Right" Text="🔊" Margin="8,0,0,0"
                                           Visibility="{Binding HasSound, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#FF9B9B" Margin="8,0,0,0"
                                           Visibility="{Binding Status, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <vlc:VideoView x:Name="MvVideo0"/>
                    </DockPanel>
                </Border>
                <Border x:Name="MvPane1" DataContext="{Binding MultiView.Panes[1]}" Margin="4"
                        BorderThickness="3" Background="Black"
                        Visibility="{Binding InUse, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSound}" Value="True">
                                    <Setter Property="BorderBrush" Value="#FFD60A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <!-- The label is the click target for the sound: the video itself is a native
                             window that WPF never sees clicks on. -->
                        <Button DockPanel.Dock="Top" Cursor="Hand" Padding="10,5" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.MultiView.SelectSoundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#FF171C22" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontWeight="Bold" Margin="0,0,8,0"
                                           Foreground="{StaticResource Accent}"/>
                                <TextBlock DockPanel.Dock="Right" Text="🔊" Margin="8,0,0,0"
                                           Visibility="{Binding HasSound, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#FF9B9B" Margin="8,0,0,0"
                                           Visibility="{Binding Status, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <vlc:VideoView x:Name="MvVideo1"/>
                    </DockPanel>
                </Border>
                <Border x:Name="MvPane2" DataContext="{Binding MultiView.Panes[2]}" Margin="4"
                        BorderThickness="3" Background="Black"
                        Visibility="{Binding InUse, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSound}" Value="True">
                                    <Setter Property="BorderBrush" Value="#FFD60A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <!-- The label is the click target for the sound: the video itself is a native
                             window that WPF never sees clicks on. -->
                        <Button DockPanel.Dock="Top" Cursor="Hand" Padding="10,5" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.MultiView.SelectSoundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#FF171C22" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontWeight="Bold" Margin="0,0,8,0"
                                           Foreground="{StaticResource Accent}"/>
                                <TextBlock DockPanel.Dock="Right" Text="🔊" Margin="8,0,0,0"
                                           Visibility="{Binding HasSound, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#FF9B9B" Margin="8,0,0,0"
                                           Visibility="{Binding Status, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <vlc:VideoView x:Name="MvVideo2"/>
                    </DockPanel>
                </Border>
                <Border x:Name="MvPane3" DataContext="{Binding MultiView.Panes[3]}" Margin="4"
                        BorderThickness="3" Background="Black"
                        Visibility="{Binding InUse, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSound}" Value="True">
                                    <Setter Property="BorderBrush" Value="#FFD60A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <!-- The label is the click target for the sound: the video itself is a native
                             window that WPF never sees clicks on. -->
                        <Button DockPanel.Dock="Top" Cursor="Hand" Padding="10,5" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.MultiView.SelectSoundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#FF171C22" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontWeight="Bold" Margin="0,0,8,0"
                                           Foreground="{StaticResource Accent}"/>
                                <TextBlock DockPanel.Dock="Right" Text="🔊" Margin="8,0,0,0"
                                           Visibility="{Binding HasSound, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#FF9B9B" Margin="8,0,0,0"
                                           Visibility="{Binding Status, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <vlc:VideoView x:Name="MvVideo3"/>
                    </DockPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{Binding MuteText}" Style="{StaticResource GhostButton}" MinWidth="112"
                            Command="{Binding ToggleMuteCommand}"/>
                    <Button Content="⛶  Full Screen" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Click="FullScreen_Click"/>
                    <Button Content="⏹  Stop" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Command="{Binding MultiView.StopCommand}"/>
                </StackPanel>
                <TextBlock Text="Click a channel's name, or press ← → or 1–4, to hear it · M mute · F11 for full screen · Esc to exit"
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
