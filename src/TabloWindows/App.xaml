<Application x:Class="TabloWindows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TabloWindows.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BytesToSizeConverter x:Key="BytesToSize"/>
            <conv:DateToLocalConverter x:Key="DateToLocal"/>
            <conv:SecondsToDurationConverter x:Key="SecondsToDuration"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:CountToVisibilityConverter x:Key="CountToVis"/>
            <conv:ScheduleVerbConverter x:Key="ScheduleVerb"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
