<UserControl x:Class="TabloWindows.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TabloWindows.ViewModels"
             d:DataContext="{d:DesignInstance vm:GuideViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <UserControl.Resources>
        <!-- position a guide block on its row canvas -->
        <Style x:Key="BlockContainer" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
            <Setter Property="Canvas.Top" Value="4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Grid.Row="0" Margin="28,22,28,12" LastChildFill="False">
            <TextBlock Text="Guide" Style="{StaticResource H1}" DockPanel.Dock="Left"/>
            <Button Content="Refresh" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                    Command="{Binding RefreshCommand}"/>
            <ComboBox DockPanel.Dock="Right" Width="180" Margin="0,0,10,0" VerticalAlignment="Center"
                      ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}"
                      DisplayMemberPath="Label"/>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                       Margin="0,0,16,0" Text="{Binding StatusMessage}"/>
        </DockPanel>

        <!-- time ruler -->
        <Grid Grid.Row="1" Margin="28,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}"/>
            <ScrollViewer Grid.Column="1" x:Name="RulerSV" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Hidden" Background="{StaticResource Panel}">
                <Canvas Height="30" Width="{Binding DayWidthPx}">
                    <ItemsControl ItemsSource="{Binding TimeTicks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Width="1" Height="30" Background="{StaticResource Border}"
                                            HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}"
                                               Margin="6,-24,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </ScrollViewer>
        </Grid>

        <!-- body: channel labels + program grid -->
        <Grid Grid.Row="2" Margin="28,4,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- channel labels (vertical scroll synced to body) -->
            <ScrollViewer Grid.Column="0" x:Name="LabelsSV" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GuideChannelRow}">
                            <Border Height="64" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,1"
                                    Background="{StaticResource Panel}">
                                <StackPanel VerticalAlignment="Center" Margin="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="15"/>
                                        <!-- Free streaming: watchable, but the DVR can't record it. -->
                                        <TextBlock Text="FREE" Margin="8,0,0,0" FontSize="10.5"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Accent}"
                                                   Visibility="{Binding IsFast,
                                                       Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CallSign}" Style="{StaticResource MutedText}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- program grid (both scrollbars; drives sync) -->
            <ScrollViewer Grid.Column="1" x:Name="BodySV" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" ScrollChanged="BodySV_ScrollChanged">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GuideChannelRow}">
                            <Canvas Height="64" Width="{Binding DataContext.DayWidthPx,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Background="{StaticResource Bg}">
                                <ItemsControl ItemsSource="{Binding Blocks}"
                                              ItemContainerStyle="{StaticResource BlockContainer}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GuideBlock}">
                                            <Button Width="{Binding Width}" Height="56" Cursor="Hand"
                                                    Command="{Binding DataContext.SelectBlockCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding FillBrush}" CornerRadius="5"
                                                                BorderBrush="{Binding StrokeBrush}" BorderThickness="1"
                                                                Margin="1,0" Padding="8,5">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                                           FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                                           Foreground="{StaticResource Muted}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- loading veil -->
        <Border Grid.Row="2" Background="#DD0F1216"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="260">
                <TextBlock Text="Loading guide…" HorizontalAlignment="Center" FontSize="15"
                           Foreground="{StaticResource Text}"/>
                <ProgressBar Height="6" Margin="0,12,0,0" Minimum="0" Maximum="1"
                             Value="{Binding LoadProgress}" Background="{StaticResource PanelAlt}"
                             Foreground="{StaticResource Accent}" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- detail flyout -->
        <Border Grid.Row="2" HorizontalAlignment="Right" Width="360" Margin="0,4,28,20"
                Style="{StaticResource Card}" Padding="20"
                Visibility="{Binding SelectedBlock, Converter={StaticResource NullToVis}}">
            <StackPanel DataContext="{Binding SelectedBlock}">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding TimeText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Airing.Description}" Style="{StaticResource MutedText}"
                           Margin="0,12,0,0" TextWrapping="Wrap" MaxHeight="140"/>

                <Border Background="{Binding FillBrush}" BorderBrush="{Binding StrokeBrush}" BorderThickness="1"
                        CornerRadius="5" Padding="8,4" Margin="0,14,0,0" HorizontalAlignment="Left"
                        Visibility="{Binding IsScheduled, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="● Scheduled to record" FontSize="12" Foreground="{StaticResource Text}"/>
                </Border>

                <!-- Watch now: only while the program is actually airing -->
                <Button Margin="0,16,0,0" Content="▶  Watch now" Style="{StaticResource AccentButton}"
                        Visibility="{Binding IsOnNow, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.WatchNowCommand,
                            RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                <!-- The DVR's tuners never see a free streaming channel, so it cannot record one. -->
                <TextBlock Text="Free streaming channel — the DVR cannot record it."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{Binding CanRecord, Converter={StaticResource InverseBoolToVis}}"/>

                <Button Margin="0,10,0,0" Style="{StaticResource AccentButton}"
                        Visibility="{Binding CanRecord, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.RecordEpisodeCommand,
                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <TextBlock>
                        <Run Text="●"/>
                        <Run Text="{Binding IsScheduled, Converter={StaticResource ScheduleVerb}, Mode=OneWay}"/>
                    </TextBlock>
                </Button>

                <StackPanel Visibility="{Binding Airing.SeriesPath, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="Series recording" Style="{StaticResource MutedText}" Margin="0,18,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="All episodes" Style="{StaticResource GhostButton}"
                                Command="{Binding DataContext.RecordSeriesCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="all"/>
                        <Button Content="New only" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding DataContext.RecordSeriesCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="new"/>
                        <Button Content="Off" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding DataContext.RecordSeriesCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="none"/>
                    </StackPanel>
                </StackPanel>

                <Button Content="Close" Style="{StaticResource GhostButton}" Margin="0,20,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding DataContext.SelectBlockCommand,
                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{x:Null}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
