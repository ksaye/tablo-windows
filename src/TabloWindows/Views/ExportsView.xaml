<UserControl x:Class="TabloWindows.Views.ExportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TabloWindows.ViewModels"
             xmlns:svc="clr-namespace:TabloWindows.Services"
             d:DataContext="{d:DesignInstance vm:ExportsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock Text="Exports" Style="{StaticResource H1}" DockPanel.Dock="Left"/>
            <Button Content="Clear finished" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                    Command="{Binding ClearCommand}"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type svc:ExportJob}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding OutputPath}" Style="{StaticResource MutedText}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Height="6" Margin="0,10,0,0" Minimum="0" Maximum="1"
                                                 Value="{Binding Progress}" Background="{StaticResource PanelAlt}"
                                                 Foreground="{StaticResource Accent}" BorderThickness="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StateText}" HorizontalAlignment="Right"
                                               FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Padding="10,5"
                                                Command="{Binding DataContext.CancelCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Show" Style="{StaticResource GhostButton}" Padding="10,5"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.OpenFolderCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
