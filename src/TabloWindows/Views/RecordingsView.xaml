<UserControl x:Class="TabloWindows.Views.RecordingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TabloWindows.ViewModels"
             d:DataContext="{d:DesignInstance vm:RecordingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="Recordings" Style="{StaticResource H1}" DockPanel.Dock="Left"/>
            <Button Content="Refresh" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                    Command="{Binding LoadCommand}"/>
        </DockPanel>

        <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Margin="0,6,0,14"
                   Text="{Binding StatusMessage}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RecordingItem}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="0">
                            <Grid Height="118">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="196"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail: the device's own snapshot of the recording. -->
                                <Border Grid.Column="0" CornerRadius="10,0,0,10" ClipToBounds="True"
                                        Background="#0B0E12">
                                    <Grid>
                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>

                                        <!-- Still recording? -->
                                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                    Orientation="Horizontal" Margin="8">
                                            <Border Background="#CC3D1D1D" CornerRadius="4" Padding="6,2"
                                                    Visibility="{Binding HasStateLabel, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding StateLabel}" FontSize="10.5"
                                                           FontWeight="SemiBold" Foreground="#FFC9C4"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- text -->
                                <StackPanel Grid.Column="1" Margin="18,14" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Owner}" FontSize="16.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SubLine}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                               Margin="0,7,0,0" TextTrimming="CharacterEllipsis" MaxHeight="34"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- meta + actions -->
                                <StackPanel Grid.Column="2" Margin="12,14,16,14" VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DurationText}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="  ·  " Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding SizeBytes, Converter={StaticResource BytesToSize}}"
                                                   Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                                        <Button Content="▶  Play" Style="{StaticResource AccentButton}" Padding="14,7"
                                                Command="{Binding DataContext.PlayCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Export" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.ExportCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Delete" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.DeleteCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- loading veil -->
        <Border Grid.Row="2" Background="#990F1216"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="15" Foreground="{StaticResource Muted}"/>
        </Border>
    </Grid>
</UserControl>
